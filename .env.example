# Public configuration: these two values appear in the built website.
# No API keys or secrets are required for the current FormSubmit integration.
FORM_RECIPIENT_EMAIL=rockwallroofingandgutters@gmail.com
# Optional. Set to your final HTTPS domain, without a trailing slash.
# Vercel's production deployment URL is used when this is blank.
SITE_URL=

# Server-only custom lead system. Leave disabled until database and email are configured.
LEAD_CAPTURE_ENABLED=false
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Legacy service_role key is supported if SUPABASE_SECRET_KEY is blank.
SUPABASE_SERVICE_ROLE_KEY=
OWNER_ACCESS_KEY=
RATE_LIMIT_SALT=
ALLOWED_ORIGINS=https://your-domain.com
RESEND_API_KEY=
NOTIFICATION_FROM=Rockwall Roofing <leads@your-verified-domain.com>
OWNER_NOTIFICATION_EMAIL=rockwallroofingandgutters@gmail.com
CRON_SECRET=
# Local demo storage is never allowed on Vercel. Use npm run dev:api for local demo.
LEADS_LOCAL_DEMO=false
